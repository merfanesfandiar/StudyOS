ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://studyos:studyos@db:5432/studyos
DATABASE_ADMIN_URL=postgresql+asyncpg://studyos:studyos@db:5432/postgres
SECRET_KEY=replace-with-a-long-random-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
